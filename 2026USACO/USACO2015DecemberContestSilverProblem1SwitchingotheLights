import java.io.*;
import java.util.*;

public class USACO2015DecemberContestSilverProblem1SwitchingotheLights {

    static class Switch {
        int x, y;

        Switch(int x, int y) {
            this.x = x;
            this.y = y;
        }
    }

    static int N;
    static List<Switch>[][] switches;
    static boolean[][] lit;
    static boolean[][] visited;

    static int[] dx = {-1, 1, 0, 0};
    static int[] dy = {0, 0, -1, 1};

    static boolean inside(int x, int y) {
        return x >= 0 && x < N && y >= 0 && y < N;
    }

    public static void main(String[] args) throws Exception {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));

        StringTokenizer st = new StringTokenizer(br.readLine());
        N = Integer.parseInt(st.nextToken());
        int M = Integer.parseInt(st.nextToken());

        switches = new ArrayList[N][N];
        for (int i = 0; i < N; i++) {
            for (int j = 0; j < N; j++) {
                switches[i][j] = new ArrayList<>();
            }
        }

        for (int i = 0; i < M; i++) {
            st = new StringTokenizer(br.readLine());

            int x = Integer.parseInt(st.nextToken()) - 1;
            int y = Integer.parseInt(st.nextToken()) - 1;
            int a = Integer.parseInt(st.nextToken()) - 1;
            int b = Integer.parseInt(st.nextToken()) - 1;

            switches[x][y].add(new Switch(a, b));
        }

        lit = new boolean[N][N];
        visited = new boolean[N][N];

        // Bessie starts here, and this room is initially lit.
        lit[0][0] = true;

        // Queue of rooms that Bessie can currently reach.
        Queue<int[]> queue = new ArrayDeque<>();
        queue.add(new int[]{0, 0});
        visited[0][0] = true;

        int answer = 1;

        while (!queue.isEmpty()) {
            int[] cur = queue.poll();
            int x = cur[0];
            int y = cur[1];

            // Use every switch in this room.
            for (Switch sw : switches[x][y]) {
                int nx = sw.x;
                int ny = sw.y;

                if (!lit[nx][ny]) {
                    lit[nx][ny] = true;
                    answer++;

                    /*
                     * The newly lit room might already be adjacent to
                     * a room Bessie has visited. If so, she can now enter it.
                     */
                    if (hasVisitedNeighbor(nx, ny) && !visited[nx][ny]) {
                        visited[nx][ny] = true;
                        queue.add(new int[]{nx, ny});
                    }
                }
            }

            // Move to adjacent rooms that are already lit.
            for (int d = 0; d < 4; d++) {
                int nx = x + dx[d];
                int ny = y + dy[d];

                if (inside(nx, ny) && lit[nx][ny] && !visited[nx][ny]) {
                    visited[nx][ny] = true;
                    queue.add(new int[]{nx, ny});
                }
            }
        }

        System.out.println(answer);
    }

    static boolean hasVisitedNeighbor(int x, int y) {
        for (int d = 0; d < 4; d++) {
            int nx = x + dx[d];
            int ny = y + dy[d];

            if (inside(nx, ny) && visited[nx][ny]) {
                return true;
            }
        }
        return false;
    }
}
